{
  "name": "openisd",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "Open, community-owned loudspeaker enclosure simulator that runs in any browser.",
  "license": "MIT",
  "scripts": {
    "lint": "eslint packages/",
    "typecheck": "npm run typecheck:design && npm run typecheck:persistence && npm run typecheck:ui",
    "typecheck:persistence": "tsc -p packages/persistence --noEmit",
    "typecheck:design": "tsc -p packages/design --noEmit",
    "typecheck:ui": "vue-tsc -p packages/ui --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "predev": "npx vite-node scripts/bundle-drivers.mjs && npm run lint",
    "dev": "vite",
    "prebuild": "npx vite-node scripts/bundle-drivers.mjs && npm run lint",
    "build": "vite build",
    "build:bridge": "vite build --config packages/design/vite.bridge.config.ts",
    "preview": "vite preview",
    "test": "bash scripts/test.sh",
    "test:unit": "vitest run",
    "test:crosscheck": "OPENISD_EXTERNAL=1 bash scripts/test-browser.sh packages/ui/test/logic/micka-crosscheck.browser.spec.ts --timeout=60000",
    "test:visual": "bash scripts/test-browser.sh packages/ui/test/ui/visual.browser.spec.ts",
    "gen-scenarios": "vite-node packages/ui/test/gen-scenarios.ts",
    "gen-golden": "vite-node packages/engine/test/gen-golden.ts"
  },
  "keywords": [
    "loudspeaker",
    "speaker",
    "enclosure",
    "thiele-small",
    "winisd",
    "acoustics",
    "diyaudio",
    "simulator"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.20.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.6.0",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "pyright": "^1.1.411",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "typescript-language-server": "^5.3.0",
    "vite": "^8.0.16",
    "vite-node": "^3.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.2.12",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@openisd/engine": "*",
    "@openisd/winisd": "*",
    "vue": "^3.5.38"
  }
}
