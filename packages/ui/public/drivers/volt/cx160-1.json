{"added":{"value":"2026-09-12"},"brand":{"value":"Volt"},"data_sources":{"value":{"manufacturer_datasheet":"https://voltloudspeakers.co.uk/wp-content/uploads/CX160.1_V1.pdf","manufacturer_product_page":"https://voltloudspeakers.co.uk/speaker/cx160-1-6-5/"}},"description":{"value":"The CX160.1 is a lightweight paper pulp cone, coaxial drive unit with integral crossover and a ferrofluid cooled dome tweeter. The bass-midrange system features a symmetrical field magnet, dual rear suspensions and a critically doped cone & surround for low colouration and linearity. The tweeter has a 28mm voice coil and Neodymium magnet for efficiency and power handling. The entire tweeter assembly is field replaceable. Thiele-Small parameters are optimised for use in compact enclosures. High power handling, excellent dispersion and low distortion make the CX160.1 suitable for studio and fixed installation applications where quality and dynamic range are essential. The diecast aluminium chassis is vented below the suspensions to increase cooling airflow to the voice coil and magnet."},"driver_type":{"value":["full-range","coaxial"]},"manufacturer":{"value":"Volt"},"model":{"value":"CX160.1"},"product_image":{"value":"https://voltloudspeakers.co.uk/wp-content/uploads/volt-land1.jpg"},"provided_by":{"value":"OpenIsd"},"schemaVersion":3,"sku":{"value":"cx160-1"},"specs":{"woofer":{"BL_Tm":{"state":"E","value":9.5,"precision":0.05},"Basket_m":{"state":"E","value":0.16,"precision":0.0005},"Cms_m_per_N":{"state":"E","value":0.00067,"precision":0.000005},"Dd_m":{"state":"C","value":0.14002817212590296,"precision":0.0002273184612489043},"EBP_hz":{"state":"C","value":111.11111111111111,"precision":2.93209876573286},"Fs_hz":{"state":"E","value":40,"precision":0.5},"Gloss":{"state":"C","value":0.02587555691578468,"precision":0.0028031853477224204},"Hc_m":{"state":"E","value":0.0175,"precision":0.00005},"Hg_m":{"state":"E","value":0.0055,"precision":0.00005},"Le_H":{"state":"E","value":0.00067,"preci