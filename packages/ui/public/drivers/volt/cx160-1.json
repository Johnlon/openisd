{"added":{"value":"2026-09-12"},"brand":{"value":"Volt"},"data_sources":{"value":{"manufacturer_datasheet":"https://voltloudspeakers.co.uk/wp-content/uploads/CX160.1_V1.pdf","manufacturer_product_page":"https://voltloudspeakers.co.uk/speaker/cx160-1-6-5/"}},"description":{"value":"The CX160.1 is a lightweight paper pulp cone, coaxial drive unit with integral crossover and a ferrofluid cooled dome tweeter. The bass-midrange system features a symmetrical field magnet, dual rear suspensions and a critically doped cone & surround for low colouration and linearity. The tweeter has a 28mm voice coil and Neodymium magnet for efficiency and power handling. The entire tweeter assembly is field replaceable. Thiele-Small parameters are optimised for use in compact enclosures. High power handling, excellent dispersion and low distortion make the CX160.1 suitable for studio and fixed installation applications where quality and dynamic range are essential. The diecast aluminium chassis is vented below the suspensions to increase cooling airflow to the voice coil and magnet."},"driver_type":{"value":["full-range","coaxial"]},"manufacturer":{"value":"Volt"},"model":{"value":"CX160.1"},"product_image":{"value":"https://voltloudspeakers.co.uk/wp-content/uploads/volt-land1.jpg"},"provided_by":{"value":"OpenIsd"},"quality":{"invalid":[],"issue":"coax:hf-specs-not-published","parse_errors":["SPL_dB='(1w / 1m) 89 dB': datasheet prints '(1w / 1m) 89 dB', a measurement condition before the value, not one reading"]},"sku":{"grounds":[{"origin":"manufacturer_product_page","reading":"CX160.1"},{"origin":"manufacturer_product_page","reading":"https://voltloudspeakers.co.uk/speaker/cx160-1-6-5/"}],"value":"cx160-1"},"specs":{"woofer":{"BL_Tm":{"readings":{"manufacturer_datasheet":{"actual_reading":"9.5 N/A","read_precision":0.05,"read_value":9.5},"manufacturer_product_page":{"actual_reading":"9.5 N/A","read_precision":0.05,"read_value":9.5}},"state":"N"},"Basket_m":{"corroboration":"UNMATCHED",