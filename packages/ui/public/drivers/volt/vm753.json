{"added":{"value":"2026-09-12"},"brand":{"value":"Volt"},"data_sources":{"value":{"manufacturer_datasheet":"https://voltloudspeakers.co.uk/wp-content/uploads/VM753_v1.1.pdf","manufacturer_product_page":"https://voltloudspeakers.co.uk/speaker/vm753-3inch/"}},"description":{"value":"The VM753 is a 16 ohm version 3\" (75mm) diameter dome unit loaded by a short, front mounted horn. It uses a lightweight single layer, round wire copper coil slightly longer than the focussed magnet gap to allow for high excursions at the lower end of its operating range. The dome and surround are critically doped for smoothness and consistency of response, a second, rear surround maintains coil stability. An FEA designed magnet system uses a 155mm ceramic magnet for high efficiency and is solidly fixed to a painted, aluminium chassis. The termination braids are hidden inside the unit and are not visible, connection is by 6.4mm (0.25\") spade terminals allowing soldering or push on receptacles. The entire dome/coil assembly is built onto a replaceable ring that accurately self locates so allowing easy field replacement. The unit is intended for rear mounting, M5 threaded inserts are incorporated in the flange for fixing screws."},"driver_type":{"value":["midrange"]},"manufacturer":{"value":"Volt"},"model":{"value":"VM753"},"product_image":{"value":"https://voltloudspeakers.co.uk/wp-content/uploads/volt-land1.jpg"},"provided_by":{"value":"OpenIsd"},"schemaVersion":3,"sku":{"value":"vm753"},"specs":{"woofer":{"BL_Tm":{"state":"C","value":8.751537813657547,"precision":0.25452994982000376},"Cms_m_per_N":{"state":"C","value":0.00003471567574079102,"precision":0.0000016939118098100413},"Dd_m":{"state":"C","value":0.08519075891779829,"precision":0.00037364367946185473},"EBP_hz":{"state":"C","value":319.1489361702128,"precision":1.4863437452845571},"Fs_hz":{"state":"E","value":450,"precision":0.5},"Gloss":{"state":"C","value":0.0012266930686001627,"precision":0.0006160726722335151},"Le_H":{"state"