{"added":{"value":"2026-09-12"},"brand":{"value":"Volt"},"data_sources":{"value":{"manufacturer_datasheet":"https://voltloudspeakers.co.uk/wp-content/uploads/RV3863.pdf","manufacturer_product_page":"https://voltloudspeakers.co.uk/speaker/rv3863-15inch/"}},"description":{"value":"The RV3863 is a unique loudspeaker that uses Radial Technology to allow exceptional power handling and reliability. The RV3863 features three cooling systems. In addition to a vented magnet it uses the patented Radial chassis, which acts as a giant heatsink, plus a multi-finned magnet intercooler. This keeps voice coil temperatures exceptionally low resulting in 3dB less power compression and tight, clean bass after prolonged operation at maximum power. The symmetrical field magnet system has an extended pole for linear excursions and maximum cooling for the 4 layer voice coil. The cone is doped for minimal colouration."},"driver_type":{"value":["bass"]},"manufacturer":{"value":"Volt"},"model":{"value":"RV3863"},"product_image":{"value":"https://voltloudspeakers.co.uk/wp-content/uploads/volt-land1.jpg"},"provided_by":{"value":"OpenIsd"},"schemaVersion":3,"sku":{"value":"rv3863"},"specs":{"woofer":{"BL_Tm":{"state":"E","value":19.3,"precision":0.05},"Basket_m":{"state":"E","value":0.357,"precision":0.0005},"Cms_m_per_N":{"state":"E","value":0.000253,"precision":5e-7},"Dd_m":{"state":"C","value":0.31107266900175007,"precision":0.00010232653585573459},"EBP_hz":{"state":"C","value":87.87878787878788,"precision":2.846648301492394},"Fs_hz":{"state":"E","value":29,"precision":0.5},"Gloss":{"state":"C","value":0.03938253609061164,"precision":0.0016205687272986824},"Le_H":{"state":"E","value":0.0031,"precision":0.00005},"Mms_kg":{"state":"E","value":0.119,"precision":0.0005},"Mpow_N_per_sqrtW":{"state":"C","value":8.013888805885907,"precision":0.055303994129118905},"Outer_m":{"state":"E","value":0.387,"precision":0.0005},"Pe_W":{"state":"E","value":400,"precision":0.5},"Qes":{"state":"E","value":0.33