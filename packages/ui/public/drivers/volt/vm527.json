{"added":{"value":"2026-09-12"},"brand":{"value":"Volt"},"data_sources":{"value":{"manufacturer_datasheet":"https://voltloudspeakers.co.uk/wp-content/uploads/VM527_v1.1.pdf","manufacturer_product_page":"https://voltloudspeakers.co.uk/speaker/vm527-2inch/"}},"description":{"value":"The VM527 is a 2\" (52mm) soft midrange dome unit which has been designed for a smooth extended response with minimal colouration and low distortion over the critical midband frequencies. The coated one piece fabric dome/surround is coupled with a lightweight Kapton/Nomex, single layer, round wire copper voice coil for accurate transient response. An FEA designed magnet system ensures linear coil movement even at high power levels. The magnet system develops high magnetic flux density due to its precise gap clearance enabling excellent heat dissipation for high power handling and efficiency. Wide dispersion is controlled by the short, optimally angled front mounted horn flare which also incorporates the threaded fixing points for rear mounting. The termination braids are hidden inside the unit and are not visible, connection is by 6.4mm (0.25\") spade terminals allowing soldering or push on receptacles. The entire dome/coil assembly is built onto a replaceable ring that accurately self locates so allowing easy field replacement."},"driver_type":{"value":["midrange"]},"manufacturer":{"value":"Volt"},"model":{"value":"VM527"},"product_image":{"value":"https://voltloudspeakers.co.uk/wp-content/uploads/volt-land1.jpg"},"provided_by":{"value":"OpenIsd"},"schemaVersion":3,"sku":{"value":"vm527"},"specs":{"woofer":{"BL_Tm":{"state":"N","readings":{"manufacturer_product_page":{"actual_reading":"n/a","rejected":"no-numeric-value"}}},"Basket_m":{"state":"E","value":0.109,"precision":0.0005},"Cms_m_per_N":{"state":"N","readings":{"manufacturer_product_page":{"actual_reading":"n/a","rejected":"no-numeric-value"}}},"Dd_m":{"state":"C","value":0.059995401431828965,"precision":0.000005305571405822551},"F