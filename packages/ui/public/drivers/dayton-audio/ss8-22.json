{"added":{"value":"2026-09-24"},"authoritative":{"value":"manufacturer_product_page"},"brand":{"value":"Dayton Audio"},"comment":{"value":"Generated by OpenIsd"},"curves":{"frequency_response":{"origin":"manufacturer_datasheet","value":{"data_format":"frd","local_path":"response_data/response.frd","type":"FILE"}},"impedance":{"origin":"manufacturer_datasheet","value":{"data_format":"zma","local_path":"response_data/response.zma","type":"FILE"}}},"data_sources":{"value":{"manufacturer_datasheet":"https://daytonaudio.com/images/resources/295-728--dayton-audio-ss8-22-specification-sheet.pdf","manufacturer_product_page":"https://daytonaudio.com/product/2126/ss8-22-8-signature-series-dvc-subwoofer-2-ohms-per-coil"}},"description":{"value":"The Dayton Audio SS8-22 Signature Series 8\" Subwoofer packs serious performance into a compact format, making it an ideal choice for small subwoofer systems where space is limited but output and accuracy are essential. Featuring a rigid anodized aluminum cone, dual-spider suspension, and a powerful triple-stacked motor assembly, the SS8-22 maintains precise pistonic motion and low distortion at high excursion. A 2.5\" 4-layer copper voice coil on a vented aluminum former provides reliable cooling and allows the driver to handle up to 500 watts RMS with ease. Optimized for DSP-assisted sealed enclosures or compact vented/passive radiator systems, the SS8-22 is equally at home in home theater, hi-fi music systems, or car audio installs where clean, impactful bass from a small footprint is required.Product HighlightsMassive triple-stacked magnet assembly provides motor strength and symmetry at high excursionAluminum shorting sleeve, ring, and pole cap linearize inductance and reduce distortionDual spider suspension with stitched tinsel leads ensures stability, durability, and precise motion2.5\" 4-layer copper voice coil on a vented aluminum former for excellent power handling and coolingRigid anodized aluminum cone with indexed edge for pistonic accuracy and reduced resonanceExtensive venting through cone, pole piece, spider, and gap minimizes compression during long sessionsProduct Manuals / Spec Sheets / DownloadsDayton Audio SS8-22 Specification SheetDayton Audio SS8-22 Graphs/FRD/ZMA Data FileBuying OptionsBuy on Parts ExpressBuy Internationally"},"driver_type":{"value":"woofer"},"manufacturer":{"value":"Dayton Audio"},"model":{"value":"SS8-22 8\" Signature Series DVC Subwoofer 2 Ohms per Coil"},"nominal_size_cm":{"value":20.32},"product_image":{"value":"https://www.daytonaudio.com/images/product/large/2126.jpg"},"provided_by":{"value":"OpenIsd"},"quality":{"cross_source_only":[],"invalid":[],"missing":[],"parse_errors":["Znom_ohm='2 + 2 ohms' (+ 2 ohms): unit '+ 2 ohms' (normalised '+2ohms') not recognised for field 'Znom_ohm'; if the source really prints that unit, add it to SpecField('Znom_ohm').si in record_registries.py","Znom_ohm='2 + 2 ohms' (+ 2 ohms): unit '+ 2 ohms' (normalised '+2ohms') not recognised for field 'Znom_ohm'; if the source really prints that unit, add it to SpecField('Znom_ohm').si in record_registries.py","Znom_ohm='2 + 2 ohms' (+ 2 ohms): unit '+ 2 ohms' (normalised '+2ohms') not recognised for field 'Znom_ohm'; if the source really prints that unit, add it to SpecField('Znom_ohm').si in record_registries.py"]},"series":{"value":"Signature Series"},"sku":{"grounds":[{"origin":"manufacturer_product_page","reading":"SS8-22 8\" Signature Series DVC Subwoofer 2 Ohms per Coil"},{"origin":"manufacturer_product_page","reading":"https://daytonaudio.com/product/2126/ss8-22-8-signature-series-dvc-subwoofer-2-ohms-per-coil"}],"value":"ss8-22"},"specs":{"woofer":{"BL_Tm":{"corroboration":"MATCH","dq_calculated":[],"origin":"manufacturer_datasheet","readings":{"manufacturer_datasheet":{"actual_reading":"14.6 Tm","read_precision":0.05,"read_value":14.6},"manufacturer_product_page":{"actual_reading":"14.6 Tm","read_precision":0.05,"read_value":14.6}},"state":"E","value":14.6},"Cms_