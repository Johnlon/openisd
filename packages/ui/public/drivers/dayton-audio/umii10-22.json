{"added":{"value":"2026-09-24"},"brand":{"value":"Dayton Audio"},"curves":{"frequency_response":{"origin":"manufacturer_datasheet","value":{"data_format":"frd","local_path":"response_data/response.frd","type":"FILE"}},"impedance":{"origin":"manufacturer_datasheet","value":{"data_format":"zma","local_path":"response_data/response.zma","type":"FILE"}}},"data_sources":{"value":{"manufacturer_datasheet":"https://daytonaudio.com/images/resources/295-710--dayton-audio-UMII10-22-spec-sheet.pdf","manufacturer_product_page":"https://daytonaudio.com/product/2063/umii10-22-ultimax-ii-10-dvc-subwoofer-2-ohms-per-coil"}},"description":{"value":"Introducing the UMII10-22 Ultimax II 10\" Carbon Fiber Cone subwoofer from Dayton Audio. Building on the success of their predecessor, these subwoofers have been meticulously engineered to surpass expectations. With improved excursion capability, lower distortion, higher power handling, better efficiency, and increased output, the Ultimax II subwoofers elevate your audio experience to new depths. Immerse yourself in rich, booming bass that will shake you to the core. Dayton Audio continues to redefine the boundaries of excellence with the UMII10-22 subwoofer. Product Highlights A large aluminum shorting cap and sleeve help keep inductance linear to guarantee minimal distortion The rigid yet lightweight woven carbon fiber cone delivers quick, detailed, and accurate response With 20 mm xmax, you can expect powerful and deep bass response, taking your audio experience to the next level Equipped with a 4-layer 2-1/2\" flat wound voice coil that can handle up to 600 watts RMS The frame and motor include extensive venting ensuring efficient heat dissipation for consistent and reliable operation, while minimizing power compression Dual spiders maintain cone linearity even at extremely high excursion levels, providing peak audio performance at all times Optimized for compact sealed enclosures, but capable of exceptional low frequency extension in vented designs - offering you the freedom to create the perfect audio setup"},"driver_type":{"value":["woofer","subwoofer"]},"manufacturer":{"value":"Dayton Audio"},"model":{"value":"UMII10-22 Ultimax II 10\" DVC Subwoofer 2 Ohms Per Coil"},"nominal_size_cm":{"value":25.4},"product_image":{"value":"https://www.daytonaudio.com/images/product/large/2063.jpg"},"provided_by":{"value":"OpenIsd"},"quality":{"invalid":[],"parse_errors":[]},"series":{"value":"Ultimax II Series"},"sku":{"grounds":[{"origin":"manufacturer_product_page","reading":"UMII10-22 Ultimax II 10\" DVC Subwoofer 2 Ohms Per Coil"},{"origin":"manufacturer_product_page","reading":"https://daytonaudio.com/product/2063/umii10-22-ultimax-ii-10-dvc-subwoofer-2-ohms-per-coil"}],"value":"umii10-22"},"specs":{"woofer":{"BL_Tm":{"corroboration":"MATCH","dq_calculated":[{"detail":"electrical damping (Rme), force factor (BL), coil resistance (Re) disagree by 36.9%: Rme = Bl²/Re. Every field in the group is marked - correct one of them, or clear one to let it be calculated.","kind":"calc","params":{"actual":44.980721116877426,"expected":89.78,"fields":["Rme_kg_per_s","BL_Tm","Re_ohm"],"formula":"Rme = Bl²/Re","relative":0.3687009084326853,"target":"Rme_kg_per_s"},"rule":"inconsistent-inputs","severity":"error"}],"origin":"manufacturer_datasheet","readings":{"manufacturer_datasheet":{"actual_reading":"13.4 Tm","read_precision":0.05,"read_value":13.4},"manufacturer_product_page":{"actual_reading":"13.4 Tm","read_precision":0.05,"read_value":13.4}},"state":"E","value":13.4},"Basket_m":{"corroboration":"UNMATCHED","origin":"manufacturer_product_page","readings":{"manufacturer_product_page":{"actual_reading":"180 mm","read_precision":0.0005,"read_value":0.18}},"state":"E","value":0.18},"Cms_m_per_N":{"corroboration":"MATCH","dq_calculated":[{"detail":"force factor (BL), coil resistance (Re), resonance (Fs), Qes, compliance (Cms) disagree by 20.7%: Bl = √(Re/(2π·Fs·Qes·Cms)). Every field in the group is marked - correct 