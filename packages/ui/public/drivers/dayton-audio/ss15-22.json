 extreme durabilityExtensive venting through cone, pole piece, spider, and gap minimizes compression during long sessionsProduct Manuals / Spec Sheets / DownloadsDayton Audio SS15-22 Specification SheetDayton Audio SS15-22 Graphs/FRD/ZMA Data FileBuying OptionsBuy on Parts ExpressBuy Internationally"},"driver_type":{"value":"woofer"},"manufacturer":{"value":"Dayton Audio"},"model":{"value":"SS15-22 15\" Signature Series DVC Subwoofer 2 Ohms per Coil"},"nominal_size_cm":{"value":38.1},"product_image":{"value":"https://www.daytonaudio.com/images/product/large/2129.jpg"},"provided_by":{"value":"OpenIsd"},"quality":{"cross_source_only":[],"invalid":[],"missing":[],"parse_errors":["Znom_ohm='2 + 2 ohms' (+ 2 ohms): unit '+ 2 ohms' (normalised '+2ohms') not recognised for field 'Znom_ohm'; if the source really prints that unit, add it to SpecField('Znom_ohm').si in record_registries.py","Znom_ohm='2 + 2 ohms' (+ 2 ohms): unit '+ 2 ohms' (normalised '+2ohms') not recognised for field 'Znom_ohm'; if the source really prints that unit, add it to SpecField('Znom_ohm').si in record_registries.py","Znom_ohm='2 + 2 ohms' (+ 2 ohms): unit '+ 2 ohms' (normalised '+2ohms') not recognised for field 'Znom_ohm'; if the source really prints that unit, add it to SpecField('Znom_ohm').si in record_registries.py"]},"series":{"value":"Signature Series"},"sku":{"grounds":[{"origin":"manufacturer_product_page","reading":"SS15-22 15\" Signature Series DVC Subwoofer 2 Ohms per Coil"},{"origin":"manufacturer_product_page","reading":"https://daytonaudio.com/product/2129/ss15-22-15-signature-series-dvc-subwoofer-2-ohms-per-coil"}],"value":"ss15-22"},"specs":{"woofer":{"BL_Tm":{"corroboration":"MATCH","dq_calculated":[],"origin":"manufacturer_datasheet","readings":{"manufacturer_datasheet":{"actual_reading":"24.9 Tm","read_precision":0.05,"read_value":24.9},"manufacturer_product_page":{"actual_reading":"24.9 Tm","read_precision":0.05,"read_value":24.9}},"state":"E","value":24.9},"Cms_m_per_N":{"co