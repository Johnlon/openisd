{
  "name": "@openisd/model",
  "version": "0.1.0",
  "type": "module",
  "description": "The OpenISD driver record and OpenISDDriver — the app's driver model, its provenance, its derivation, and its .wdr bridge (toWinISDDriver/fromWinISDDriver). No DOM, no app state.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./driverStanding": {
      "types": "./src/driverStanding.ts",
      "default": "./src/driverStanding.ts"
    },
    "./driverSimulatability": {
      "types": "./src/driverSimulatability.ts",
      "default": "./src/driverSimulatability.ts"
    },
    "./driverConformance": {
      "types": "./src/driverConformance.ts",
      "default": "./src/driverConformance.ts"
    }
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@openisd/engine": "*",
    "@openisd/winisd": "*",
    "yaml": "^2.9.0"
  }
}
