[Unit]
Description=OpenISD live Vite dev server (port 4000, main checkout)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/john/work/winisd/openisd
ExecStart=/usr/bin/node /home/john/work/winisd/openisd/node_modules/vite/bin/vite.js --host 0.0.0.0 --port 4000 --strictPort
Restart=always
RestartSec=10
MemoryMax=2G

[Install]
WantedBy=default.target
