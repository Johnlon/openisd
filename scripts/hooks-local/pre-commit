#!/bin/sh
# Fast gate on every commit: with a claimed task (.task), the staged files must be inside that
# task's `files` allowlist. No test suite runs here; the fast gates and the done_test run in
# scripts/land.sh, the full suite in the post-land run (docs/DEV_PROCESS.md).
exec bash "$(git rev-parse --show-toplevel)/scripts/land/task-gates/check-commit.sh"
