#!/bin/sh
# openisd-specific pre-push extras, invoked by the SHARED hook
# (../scripts/hooks/pre-push) after the agent self-attribution gate has passed.
# The shared hook replays the ref list on stdin, so it is read here exactly as
# git would have delivered it.
#
# stdin carries the ref list and can only be read ONCE, so capture it up front and
# replay it to every consumer below.
refs=$(cat)

# Exception: if every commit being pushed touches ONLY *.md files, skip the full
# CI run (the unit/browser suites add no signal for doc-only changes, and the
# browser suite is the slow part) — but lint + typecheck are whole-project checks,
# so they STILL run: a doc-only push of a branch that is already red must not ship
# pre-existing failures. A brand-new branch/ref, or any push that includes even one
# non-.md change, always runs the full gate.
z40=0000000000000000000000000000000000000000
doc_only=1
while read local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$z40" ] && continue
  if [ "$remote_oid" = "$z40" ]; then
    doc_only=0
    continue
  fi
  changed=$(git diff --name-only "$remote_oid..$local_oid" --diff-filter=ACMR)
  if [ -n "$changed" ] && printf '%s\n' "$changed" | grep -qv '\.md$'; then
    doc_only=0
  fi
done <<REFS
$refs
REFS

if [ "$doc_only" = "1" ]; then
  echo "[pre-push] doc-only push (*.md) — skipping unit/browser; typecheck + lint still run to block a red branch…"
  npm run typecheck
  npm run lint
  echo "[pre-push] doc-only + typecheck/lint green ✓"
  exit 0
fi

npm run ci
