#!/bin/sh
# openisd pre-push gate: the agent self-attribution check. No test suite runs here (docs/DEV_PROCESS.md).
#
# stdin carries the ref list and can only be read ONCE, so capture it up front and
# replay it to every consumer below.
refs=$(cat)

# ── AI attribution gate ──────────────────────────────────────────────────────────────
# Every commit being pushed must be free of AI attribution (see
# scripts/hooks-local/no-ai-attribution.sh). commit-msg already blocks this at commit
# time; repeating it here is what stops a `git commit --no-verify` reaching a remote.
guard="$(git rev-parse --show-toplevel)/scripts/hooks-local/no-ai-attribution.sh"
z40=0000000000000000000000000000000000000000
attribution_failed=0
while read local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$z40" ] && continue
  if [ "$remote_oid" = "$z40" ]; then
    # New remote ref — every commit not already on some remote is being published.
    range=$(git rev-list "$local_oid" --not --remotes)
  else
    range=$(git rev-list "$remote_oid..$local_oid")
  fi
  for sha in $range; do
    if ! git log -1 --format=%B "$sha" | "$guard"; then
      echo "    ...in commit $(git log -1 --format='%h %s' "$sha")"
      attribution_failed=1
    fi
  done
done <<REFS
$refs
REFS

if [ "$attribution_failed" = "1" ]; then
  echo "[pre-push] BLOCKED — rewrite the offending messages (git rebase -i) and push again."
  exit 1
fi
