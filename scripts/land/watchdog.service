[Unit]
Description=OpenISD watchdog tick (SDLC S3)

[Service]
Type=oneshot
# A hung git must not leave the tick active forever (OnUnitActiveSec would never fire again).
TimeoutStartSec=300
# The installed copy of scripts/land/watchdog-boot.sh, never a file in the main checkout (T304): it runs
# origin/main's watchdog.
ExecStart=/usr/bin/bash %h/.local/libexec/openisd/watchdog-boot.sh
